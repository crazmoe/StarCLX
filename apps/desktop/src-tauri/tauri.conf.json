{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "starclx",
  "version": "1.3.9",
  "identifier": "ch.crazmoe.starface-linuxclient",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "StarCLX",
        "width": 1000,
        "height": 700,
        "minWidth": 800,
        "minHeight": 480,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "StarCLX – freier Client für STARFACE-Telefonanlagen",
    "linux": {
      "deb": {
        "desktopTemplate": "./starclx.desktop",
        "conflicts": [
          "starface-linuxclient"
        ],
        "replaces": [
          "starface-linuxclient"
        ],
        "depends": [
          "libpipewire-0.3-0t64 | libpipewire-0.3-0",
          "libpulse0",
          "libasound2t64 | libasound2",
          "libssl3t64 | libssl3"
        ],
        "files": {
          "/usr/lib/udev/rules.d/60-starclx-busylight.rules": "udev/60-starclx-busylight.rules"
        }
      },
      "appimage": {},
      "rpm": {
        "desktopTemplate": "./starclx.desktop",
        "conflicts": [
          "starface-linuxclient"
        ],
        "obsoletes": [
          "starface-linuxclient"
        ],
        "depends": [
          "libwebkit2gtk-4.1.so.0()(64bit)",
          "libgtk-3.so.0()(64bit)",
          "libpipewire-0.3.so.0()(64bit)",
          "libpulse.so.0()(64bit)",
          "libasound.so.2()(64bit)",
          "libssl.so.3()(64bit)"
        ],
        "recommends": [
          "libayatana-appindicator3.so.1()(64bit)"
        ],
        "files": {
          "/usr/lib/udev/rules.d/60-starclx-busylight.rules": "udev/60-starclx-busylight.rules"
        }
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "starface-app",
          "tel",
          "callto",
          "sip"
        ]
      }
    }
  }
}
