{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StarCLX",
  "identifier": "ch.crazmoe.starcmx",
  "bundle": {
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../LICENSE": "LICENSE.txt",
      "THIRD-PARTY-LICENSES.txt": "THIRD-PARTY-LICENSES.txt"
    },
    "shortDescription": "StarCLX – freier Client für STARFACE-Telefonanlagen",
    "publisher": "crazmoe",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German",
          "English",
          "French",
          "Italian"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "tel",
          "callto",
          "sip"
        ]
      }
    }
  }
}
